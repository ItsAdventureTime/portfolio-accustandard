[Unit]
Description=Accustanda ERP Dashboard Demo Container
After=network-online.target

[Container]
ContainerName=bridge-ph-accustanda-demo
Image=docker.io/library/nginx:alpine
Volume=/home/jk/bridge-ph/accustanda-demo:/usr/share/nginx/html:ro,z
PublishPort=127.0.0.1:3000:80

[Service]
Restart=always

[Install]
WantedBy=default.target
