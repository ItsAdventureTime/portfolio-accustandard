#!/usr/bin/env bash
set -euo pipefail
PATH=/usr/sbin:/usr/bin:/sbin:/bin
export PATH
unset BASH_ENV ENV

RELEASE_ROOT="/home/jk/bridge-ph/accustandard-demo/release/demo"
STATIC_DEST="/srv/bridge-ph-accustandard-demo/web-dist"
HANDLER_DEST="/etc/caddy/accustandard-demo.handlers.Caddyfile"

fail() { echo "accustandard-demo-activate: $*" >&2; exit 1; }

[[ "$(id -u)" -eq 0 ]] || fail "must run as root"

check_installation() {
  [[ -d /home/jk/bridge-ph/accustandard-demo ]] || fail "deployment root missing"
  [[ -d /srv ]] || fail "/srv missing"
  [[ -d /etc/caddy ]] || fail "/etc/caddy missing"
  [[ -f "${HANDLER_DEST}" ]] || fail "canonical Caddy handler missing"
  [[ "$(stat -c '%u' "${HANDLER_DEST}")" == 0 ]] || fail "Caddy handler is not root-owned"
  [[ -z "$(find "${HANDLER_DEST}" -perm /0222 -print -quit)" ]] || fail "Caddy handler is writable"
}

validate_release() {
  [[ -d "${RELEASE_ROOT}" ]] || fail "release missing: ${RELEASE_ROOT}"
  [[ -d "${RELEASE_ROOT}/web-dist" ]] || fail "static export missing"
  [[ -f "${RELEASE_ROOT}/web-dist/index.html" ]] || fail "static index missing"
  [[ -f "${RELEASE_ROOT}/quadlets/accustandard-demo-app.container" ]] || fail "app Quadlet missing"
  [[ -f "${RELEASE_ROOT}/quadlets/accustandard-demo-db.container" ]] || fail "database Quadlet missing"
  [[ -f "${RELEASE_ROOT}/quadlets/accustandard-demo-pod.pod" ]] || fail "pod Quadlet missing"
  [[ -s "${RELEASE_ROOT}/accustandard-bridge-backend-demo.tar" ]] || fail "backend archive missing"
  [[ -z "$(find "${RELEASE_ROOT}" -type l -print -quit)" ]] || fail "release contains symlink"
  [[ -z "$(find "${RELEASE_ROOT}/web-dist" ! -type f ! -type d -print -quit)" ]] || fail "static export contains unsupported entry"
}

publish() {
  check_installation
  validate_release
  rm -rf -- "${STATIC_DEST}"
  mkdir -p "${STATIC_DEST}"
  cp -a "${RELEASE_ROOT}/web-dist/." "${STATIC_DEST}/"
  find "${STATIC_DEST}" -type d -exec chmod 0755 {} +
  find "${STATIC_DEST}" -type f -exec chmod 0644 {} +
  chown -R root:root "${STATIC_DEST}"
}

case "${1:-}" in
  --check) check_installation ;;
  --publish) publish ;;
  *) echo "usage: $0 --check|--publish" >&2; exit 2 ;;
esac
