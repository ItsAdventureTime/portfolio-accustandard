# Caddy Reverse Proxy Configuration Snippet for DelegateOps (delegateops.business)

delegateops.business {
    # Demo Site: https://delegateops.business/accustanda/demo
    handle_path /accustanda/demo* {
        reverse_proxy localhost:3001
    }

    # Production Site: https://delegateops.business/accustanda
    handle_path /accustanda* {
        reverse_proxy localhost:3000
    }

    encode gzip zstd
    header {
        Strict-Transport-Security "max-age=31536000;"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "SAMEORIGIN"
    }
}
