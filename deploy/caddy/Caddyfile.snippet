# Caddy Reverse Proxy Configuration Snippet for Accustandard Medical ERP
# Host: delegateops.business

delegateops.business {
    # Demo Site: https://delegateops.business/accustandard/demo
    handle_path /accustandard/demo* {
        reverse_proxy localhost:3001
    }

    # Production Site: https://delegateops.business/accustandard
    handle_path /accustandard* {
        reverse_proxy localhost:3000
    }

    encode gzip zstd
    header {
        Strict-Transport-Security "max-age=31536000;"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "SAMEORIGIN"
    }
}
