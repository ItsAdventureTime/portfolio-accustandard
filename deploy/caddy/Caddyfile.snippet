# Caddy Reverse Proxy Configuration Snippet for Accustanda Bridge Dashboard

# Demo Environment
demo-accustanda.bridge.ph {
    reverse_proxy localhost:3001
    encode gzip zstd
    header {
        Strict-Transport-Security "max-age=31536000;"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "SAMEORIGIN"
    }
}

# Production Environment
accustanda.bridge.ph {
    reverse_proxy localhost:3000
    encode gzip zstd
    header {
        Strict-Transport-Security "max-age=31536000;"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "SAMEORIGIN"
    }
}
